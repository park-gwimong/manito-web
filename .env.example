# 앱
# 로컬 개발(yarn dev)이 접속할 DB. docker compose up db 를 쓰면 아래 POSTGRES_* 값과 맞춘다.
# (운영의 docker compose에서는 쓰이지 않는다. 로컬 개발용 예시 값)
DATABASE_URL=postgres://manito:change-me@localhost:5432/manito
# 세션 서명 키. 긴 무작위 문자열: openssl rand -base64 48
# 경고: 운영에서는 예시 값 금지. 반드시 새로 생성해 교체한다.
SESSION_SECRET=change-me-to-a-long-random-string
# 경고: 이벤트 개설(/new)을 지키는 비밀번호. 운영에서는 예시 값 금지, 강한 값으로 교체한다. (openssl rand -hex 12)
ADMIN_PASSWORD=change-me

# docker compose용 DB 설정 (compose에서는 DATABASE_URL을 이 값으로 다시 만든다)
POSTGRES_USER=manito
# 경고: 운영에서는 예시 값 금지. openssl rand -hex 24 로 생성해 교체한다. (영문·숫자만)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=manito

# 호스트에 공개할 앱 포트 (기본 3000)
# APP_PORT=3000
